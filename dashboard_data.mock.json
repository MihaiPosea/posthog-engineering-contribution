  "dimensions": [
    {
      "key": "feature",
      "label": "Feature Delivery",
      "default_weight": 3,
      "blurb": "New capability shipped, weighted by how central the touched code is.",
      "formula": "\u03a3 W(pr) over merged feat PRs where DRI = engineer"
    },
    {
      "key": "reliability",
      "label": "Reliability",
      "default_weight": 3,
      "blurb": "Fix/perf work delivered, scaled by whether their own features stay fixed.",
      "formula": "\u03a3 W(pr) over fix+perf PRs \u00d7 Q(e); Q = shrunk churn-quality factor"
    },
    {
      "key": "blast",
      "label": "Blast Radius",
      "default_weight": 3,
      "blurb": "How much of the load-bearing, widely-shared code they operate across.",
      "formula": "\u03a3 log2(1+\u03ba(d)) over dirs d they touch where \u03ba(d) > median"
    },
    {
      "key": "leverage",
      "label": "Review Leverage",
      "default_weight": 3,
      "blurb": "How many different engineers they unblock, and how fast.",
      "formula": "\u221a(distinct_authors \u00d7 reviews) \u00d7 latency factor"
    },
    {
      "key": "depth",
      "label": "Review Depth",
      "default_weight": 3,
      "blurb": "Whether their reviews actually changed the code.",
      "formula": "\u03a3 [(1+inline)^0.6 \u2212 1] \u00d7 (1 + followed_by_commits)"
    },
    {
      "key": "ownership",
      "label": "Ownership & Bus Factor",
      "default_weight": 3,
      "blurb": "Whether they are the person holding a critical area. Two-signed: fewer defects, more continuity risk.",
      "formula": "\u03a3 share(e,d) \u00d7 \u03ba(d) for share \u2265 0.25"
    },
    {
      "key": "agent",
      "label": "Agent Leverage",
      "default_weight": 3,
      "blurb": "Volume shipped through agents that actually held up.",
      "formula": "\u03a3 W\u2080(pr) over agent-involved PRs \u00d7 Q(e); W\u2080 excludes the autonomy factor"
    }
  ],
